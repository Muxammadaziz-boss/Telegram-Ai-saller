# App
APP_ENV=development
APP_NAME=AI Sales Assistant
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL (pgvector image is used in docker-compose)
POSTGRES_PASSWORD=change_this_local_password
DATABASE_URL=postgresql+asyncpg://sales:change_this_local_password@db:5432/aisales

# Redis is reserved for background jobs in the next iteration
REDIS_URL=redis://redis:6379/0

# Telegram Bot API
TELEGRAM_BOT_TOKEN=123456:replace_me
TELEGRAM_WEBHOOK_SECRET=replace_with_a_long_random_secret
TELEGRAM_PUBLIC_CHANNEL=public_channel_username
TELEGRAM_ADMIN_CHAT_ID=
ADMIN_TELEGRAM_ID=0  # Bosh admin Telegram User ID (masalan: 123456789)
ALLOWED_ORIGINS=http://localhost:3000

# AI Provider ("gemini" or "openai" or "auto")
AI_PROVIDER=gemini

# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Cloud AI (OpenAI API - optional fallback)
OPENAI_API_KEY=
# Optional: set this for an OpenAI-compatible provider. Leave blank for the default API endpoint.
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIM=1536

# Admin API protection (temporary single-admin token for MVP)
ADMIN_API_TOKEN=replace_with_a_long_random_admin_token
INTERNAL_INGEST_TOKEN=replace_with_a_different_long_random_token
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_characters
ENCRYPTION_KEY=replace_with_32_byte_urlsafe_base64_fernet_key

# Channel history importer (Telethon / MTProto, read-only importer)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# Local media storage
STORAGE_DIR=./storage
