# Test Environment Configuration (Template)
# Copy this file to .env.test or pass environment variables directly in CI/CD.
# DO NOT COMMIT ACTUAL PASSWORDS OR TOKENS TO SOURCE CONTROL.

TEST_BASE_URL=http://localhost:3000
DASHBOARD_PASSWORD=your_secure_test_password
